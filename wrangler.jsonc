{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "fibernet",
  "main": "src/index-v4.js",
  "compatibility_date": "2026-09-07",
  "keep_vars": true,
  "observability": { "enabled": true },
  "triggers": {
    "crons": ["15 23 * * *"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "fibernet-support",
      "database_id": "5d39dd4f-51b2-4c37-a7b8-60b1c3474203",
      "migrations_dir": "migrations"
    }
  ],
  "vars": {
    "PUBLIC_BASE_URL": "https://fibernet.nigocat8.workers.dev",
    "SUPPORT_CHAT_ID": "-1003621741530",
    "ADMIN_IDS": "7294324265",
    "BRAND_NAME": "FiberNet"
  }
}
