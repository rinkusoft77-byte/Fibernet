{
  "name": "fibernet-support-bot",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Professional FiberNet Telegram support bot for Cloudflare Workers + D1",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:migrate:local": "wrangler d1 migrations apply fibernet-support --local",
    "db:migrate:remote": "wrangler d1 migrations apply fibernet-support --remote",
    "webhook": "node scripts/setup-webhook.mjs",
    "test": "node --test tests/*.test.mjs"
  },
  "devDependencies": {
    "wrangler": "^4.0.0"
  },
  "engines": {
    "node": ">=20"
  }
}
